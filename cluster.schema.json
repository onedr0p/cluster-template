{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Api": {
      "additionalProperties": false,
      "properties": {
        "addr": {
          "format": "ipv4",
          "title": "Addr",
          "type": "string"
        },
        "vip": {
          "default": true,
          "title": "Vip",
          "type": "boolean"
        },
        "tls_sans": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/San"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tls Sans"
        }
      },
      "required": ["addr"],
      "title": "Api",
      "type": "object"
    },
    "Asn": {
      "anyOf": [
        {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        {
          "pattern": "^[0-9]+$",
          "type": "string"
        }
      ]
    },
    "Bgp": {
      "additionalProperties": false,
      "properties": {
        "router_addr": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "const": "",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Router Addr"
        },
        "router_asn": {
          "anyOf": [
            {
              "$ref": "#/$defs/Asn"
            },
            {
              "const": "",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "node_asn": {
          "anyOf": [
            {
              "$ref": "#/$defs/Asn"
            },
            {
              "const": "",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Bgp",
      "type": "object"
    },
    "Certs": {
      "additionalProperties": false,
      "properties": {
        "cluster_issuer": {
          "anyOf": [
            {
              "$ref": "#/$defs/K8sName"
            },
            {
              "const": "",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Certs",
      "type": "object"
    },
    "Cidr": {
      "format": "ipv4network",
      "type": "string"
    },
    "Cilium": {
      "additionalProperties": false,
      "properties": {
        "loadbalancer_mode": {
          "default": "dsr",
          "enum": ["dsr", "snat"],
          "title": "Loadbalancer Mode",
          "type": "string"
        },
        "announce": {
          "anyOf": [
            {
              "enum": ["l2", "bgp", "none"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Announce"
        },
        "bgp": {
          "$ref": "#/$defs/Bgp",
          "default": {
            "router_addr": null,
            "router_asn": null,
            "node_asn": null
          }
        }
      },
      "title": "Cilium",
      "type": "object"
    },
    "Dns": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "cloudflare",
          "enum": ["cloudflare", "none"],
          "title": "Provider",
          "type": "string"
        },
        "token": {
          "default": "",
          "title": "Token",
          "type": "string"
        }
      },
      "title": "Dns",
      "type": "object"
    },
    "Domain": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/DomainName"
        }
      },
      "required": ["name"],
      "title": "Domain",
      "type": "object"
    },
    "DomainName": {
      "maxLength": 230,
      "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)+([a-z]{2,63}|xn--[a-z0-9]([-a-z0-9]{0,57}[a-z0-9])?)$",
      "type": "string"
    },
    "Gateway": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["address"]
        },
        {
          "required": ["load_balancer_class"]
        }
      ],
      "properties": {
        "address": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "load_balancer_class": {
          "anyOf": [
            {
              "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Balancer Class"
        }
      },
      "title": "Gateway",
      "type": "object"
    },
    "GatewaySpec": {
      "anyOf": [
        {
          "format": "ipv4",
          "type": "string"
        },
        {
          "$ref": "#/$defs/Gateway"
        }
      ]
    },
    "Gateways": {
      "additionalProperties": false,
      "properties": {
        "internal": {
          "$ref": "#/$defs/GatewaySpec"
        },
        "dns": {
          "$ref": "#/$defs/GatewaySpec"
        },
        "external": {
          "$ref": "#/$defs/OptionalGatewaySpec",
          "default": null
        }
      },
      "required": ["internal", "dns"],
      "title": "Gateways",
      "type": "object"
    },
    "Ingress": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "anyOf": [
            {
              "enum": ["cloudflare-tunnel", "direct", "none"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to \"cloudflare-tunnel\" when dns.provider is \"cloudflare\", otherwise \"none\".",
          "title": "Mode"
        }
      },
      "title": "Ingress",
      "type": "object"
    },
    "K8sName": {
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
      "type": "string"
    },
    "Kubernetes": {
      "additionalProperties": false,
      "properties": {
        "pod_cidr": {
          "$ref": "#/$defs/Cidr",
          "default": "10.42.0.0/16"
        },
        "svc_cidr": {
          "$ref": "#/$defs/Cidr",
          "default": "10.43.0.0/16"
        },
        "coredns_addr": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "const": "",
              "type": "string"
            }
          ],
          "title": "Coredns Addr"
        },
        "api": {
          "$ref": "#/$defs/Api"
        }
      },
      "required": ["api"],
      "title": "Kubernetes",
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "properties": {
        "node_cidr": {
          "$ref": "#/$defs/Cidr"
        },
        "dns_servers": {
          "default": ["1.1.1.1", "1.0.0.1"],
          "items": {
            "format": "ipv4",
            "type": "string"
          },
          "minItems": 1,
          "title": "Dns Servers",
          "type": "array"
        },
        "ntp_servers": {
          "default": ["162.159.200.1", "162.159.200.123"],
          "items": {
            "format": "ipv4",
            "type": "string"
          },
          "minItems": 1,
          "title": "Ntp Servers",
          "type": "array"
        },
        "default_gateway": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "const": "",
              "type": "string"
            }
          ],
          "title": "Default Gateway"
        },
        "vlan_tag": {
          "anyOf": [
            {
              "$ref": "#/$defs/VlanTag"
            },
            {
              "const": "",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": ["node_cidr"],
      "title": "Network",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9\\-]{0,61}[a-z0-9]$|^[a-z0-9]$",
          "title": "Name",
          "type": "string"
        },
        "address": {
          "format": "ipv4",
          "title": "Address",
          "type": "string"
        },
        "controller": {
          "title": "Controller",
          "type": "boolean"
        },
        "disk": {
          "minLength": 1,
          "title": "Disk",
          "type": "string"
        },
        "mac_addr": {
          "pattern": "^\\s*([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\\s*$",
          "title": "Mac Addr",
          "type": "string"
        },
        "schematic_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchematicId"
            },
            {
              "const": "",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mtu": {
          "default": 1500,
          "maximum": 9000,
          "minimum": 1450,
          "title": "Mtu",
          "type": "integer"
        },
        "secureboot": {
          "default": false,
          "title": "Secureboot",
          "type": "boolean"
        },
        "encrypt_disk": {
          "default": false,
          "title": "Encrypt Disk",
          "type": "boolean"
        },
        "kernel_modules": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Kernel Modules",
          "type": "array"
        }
      },
      "required": ["name", "address", "controller", "disk", "mac_addr"],
      "title": "Node",
      "type": "object"
    },
    "OptionalGatewaySpec": {
      "anyOf": [
        {
          "format": "ipv4",
          "type": "string"
        },
        {
          "$ref": "#/$defs/Gateway"
        },
        {
          "const": "",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "Repository": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "pattern": "^(https?://|ssh://git@)[^/]+/.+$",
          "title": "Url",
          "type": "string"
        },
        "branch": {
          "default": "main",
          "minLength": 1,
          "title": "Branch",
          "type": "string"
        },
        "webhook_provider": {
          "anyOf": [
            {
              "enum": ["github", "gitlab", "generic-hmac", "none"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to \"github\", or \"none\" when ingress.mode is \"none\" or the wildcard certificate comes from the in-cluster CA.",
          "title": "Webhook Provider"
        },
        "known_hosts": {
          "default": "",
          "title": "Known Hosts",
          "type": "string"
        }
      },
      "required": ["url"],
      "title": "Repository",
      "type": "object"
    },
    "San": {
      "anyOf": [
        {
          "format": "ipv4",
          "type": "string"
        },
        {
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)*[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
          "type": "string"
        }
      ]
    },
    "SchematicId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Spegel": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        }
      },
      "title": "Spegel",
      "type": "object"
    },
    "Talos": {
      "additionalProperties": false,
      "properties": {
        "schematic_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchematicId"
            },
            {
              "const": "",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Talos",
      "type": "object"
    },
    "VlanTag": {
      "anyOf": [
        {
          "maximum": 4094,
          "minimum": 1,
          "type": "integer"
        },
        {
          "pattern": "^[0-9]+$",
          "type": "string"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "network": {
      "$ref": "#/$defs/Network"
    },
    "kubernetes": {
      "$ref": "#/$defs/Kubernetes"
    },
    "gateways": {
      "$ref": "#/$defs/Gateways"
    },
    "repository": {
      "$ref": "#/$defs/Repository"
    },
    "domain": {
      "$ref": "#/$defs/Domain"
    },
    "dns": {
      "$ref": "#/$defs/Dns"
    },
    "ingress": {
      "$ref": "#/$defs/Ingress",
      "default": {
        "mode": null
      }
    },
    "certs": {
      "$ref": "#/$defs/Certs",
      "default": {
        "cluster_issuer": null
      }
    },
    "cilium": {
      "$ref": "#/$defs/Cilium",
      "default": {
        "loadbalancer_mode": "dsr",
        "announce": null,
        "bgp": {
          "node_asn": null,
          "router_addr": null,
          "router_asn": null
        }
      }
    },
    "talos": {
      "$ref": "#/$defs/Talos",
      "default": {
        "schematic_id": null
      }
    },
    "spegel": {
      "$ref": "#/$defs/Spegel",
      "default": {
        "enabled": null
      }
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    }
  },
  "required": ["network", "kubernetes", "gateways", "repository", "domain", "dns", "nodes"],
  "title": "cluster.toml",
  "type": "object"
}
