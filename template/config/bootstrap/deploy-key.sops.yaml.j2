#| Only ssh:// repositories authenticate with the deploy key; https:// ones
   are cloned anonymously, so no Secret is rendered and the flux-instance
   HelmRelease sets no pullSecret. #|
#% if repository.uses_deploy_key %#
---
apiVersion: v1
kind: Secret
metadata:
  name: deploy-key
  namespace: flux-system
stringData:
  identity: |
    #% filter indent(width=4, first=False) %#
    #{ deploy_key() }#
    #% endfilter %#
  known_hosts: |
    #% filter indent(width=4, first=False) %#
    #{ repository.known_hosts }#
    #% endfilter %#
#% endif %#
