#% if talos.firewall %#
#| Controller-only rules of the ingress firewall; see all/80-firewall.yaml.tpl. #|
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: kubernetes-api-ingress
portSelector:
  ports: [6443]
  protocol: tcp
ingress:
  #% for cidr in talos.admin_cidrs %#
  - subnet: #{ cidr }#
  #% endfor %#
  - subnet: #{ kubernetes.pod_cidr }#
  {{- range .Data.firewall.nodes }}
  - subnet: {{ . }}
  {{- end }}
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: trustd-ingress
portSelector:
  ports: [50001]
  protocol: tcp
ingress:
  {{- range .Data.firewall.nodes }}
  - subnet: {{ . }}
  {{- end }}
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: etcd-ingress
portSelector:
  ports: [2379-2380]
  protocol: tcp
ingress:
  {{- range .Data.firewall.controllers }}
  - subnet: {{ . }}
  {{- end }}
---
# etcd, controller-manager and scheduler metrics, for Prometheus.
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: control-plane-metrics-ingress
portSelector:
  ports: [2381, 10257, 10259]
  protocol: tcp
ingress:
  - subnet: #{ kubernetes.pod_cidr }#
  {{- range .Data.firewall.nodes }}
  - subnet: {{ . }}
  {{- end }}
#% else %#
# The Talos ingress firewall is off ([talos] firewall in cluster.toml). This
# comment-only patch replaces the rules a previous render may have left here.
#% endif %#
