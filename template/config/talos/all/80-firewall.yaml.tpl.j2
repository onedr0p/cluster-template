#% if talos.firewall %#
#| Ingress firewall, following the Talos recommendations for Kubernetes
   nodes: https://docs.siderolabs.com/talos/v1.14/networking/ingress-firewall
   It filters connections to the host itself. Service traffic (LoadBalancer
   IPs, NodePorts) is translated by Cilium's eBPF datapath before it reaches
   these rules and is forwarded to pods, so it is not covered here.
   Cluster members are each node's own address from topf.yaml's
   data.firewall, not node_cidr, which may be shared with other tenants.
   Controller-only rules are in control-plane/80-firewall.yaml.tpl. #|
# Talos still accepts loopback, established connections and rate-limited ICMP.
apiVersion: v1alpha1
kind: NetworkDefaultActionConfig
ingress: block
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: apid-ingress
portSelector:
  ports: [50000]
  protocol: tcp
ingress:
  #% for cidr in talos.admin_cidrs %#
  - subnet: #{ cidr }#
  #% endfor %#
  {{- range .Data.firewall.nodes }}
  - subnet: {{ . }}
  {{- end }}
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: kubelet-ingress
portSelector:
  ports: [10250]
  protocol: tcp
ingress:
  - subnet: #{ kubernetes.pod_cidr }#
  {{- range .Data.firewall.nodes }}
  - subnet: {{ . }}
  {{- end }}
---
# Cilium node-to-node health checks; native routing needs no VXLAN port.
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: cilium-health-ingress
portSelector:
  ports: [4240]
  protocol: tcp
ingress:
  {{- range .Data.firewall.nodes }}
  - subnet: {{ . }}
  {{- end }}
---
# Cilium agent and operator metrics, for Prometheus.
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: cilium-metrics-ingress
portSelector:
  ports: [9962-9963]
  protocol: tcp
ingress:
  - subnet: #{ kubernetes.pod_cidr }#
  {{- range .Data.firewall.nodes }}
  - subnet: {{ . }}
  {{- end }}
#% else %#
# The Talos ingress firewall is off ([talos] firewall in cluster.toml). This
# comment-only patch replaces the rules a previous render may have left here.
#% endif %#
