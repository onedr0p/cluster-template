apiVersion: v1alpha1
kind: KubeletConfig
#% if kubernetes.coredns_addr_overridden %#
# Talos defaults to the 10th IP of the service subnet; keep pods pointed at
# the CoreDNS service since coredns_addr is overridden. Talos appends list
# fields, so a node patch cannot replace this, only add to it.
clusterDNS: ["#{ kubernetes.coredns_addr }#"]
#% endif %#
config:
  crashLoopBackOff:
    maxContainerRestartPeriod: 60s
  imageMaximumGCAge: 168h
  maxParallelImagePulls: 3
  serializeImagePulls: false
  shutdownGracePeriod: 90s
  shutdownGracePeriodCriticalPods: 60s
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - #{ network.node_cidr }#
