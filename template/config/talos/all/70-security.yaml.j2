# Run containerd, the kubelet and pods in a sandboxed PID/mount namespace
# (talos.workload_isolation in cluster.toml). The in-tree iSCSI volume plugin
# does not work with it enabled; use a CSI driver instead.
apiVersion: v1alpha1
kind: SecurityProfileConfig
workloadIsolation: #{ talos.workload_isolation | string | lower }#
