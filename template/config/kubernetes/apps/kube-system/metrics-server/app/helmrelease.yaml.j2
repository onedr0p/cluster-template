---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: metrics-server
spec:
  chart:
    kind: OCIRepository
    spec:
      interval: 15m
      url: oci://ghcr.io/home-operations/charts-mirror/metrics-server
      ref:
        tag: 3.14.0
  interval: 1h
  values:
    args:
      - --kubelet-insecure-tls
      - --metric-resolution=10s
      - --kubelet-request-timeout=2s
    metrics:
      enabled: true
    serviceMonitor:
      enabled: true
