#% if spegel.enabled %#
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: spegel
spec:
  chart:
    kind: OCIRepository
    spec:
      interval: 15m
      url: oci://ghcr.io/spegel-org/helm-charts/spegel
      ref:
        tag: 0.8.1
  interval: 1h
  values:
    spegel:
      containerdRegistryConfigPath: /etc/cri/conf.d/hosts
    serviceMonitor:
      enabled: true
#% endif %#
