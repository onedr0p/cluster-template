---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: reloader
spec:
  chart:
    kind: OCIRepository
    spec:
      interval: 15m
      url: oci://ghcr.io/stakater/charts/reloader
      ref:
        tag: 2.2.20
  interval: 1h
  values:
    fullnameOverride: reloader
    reloader:
      readOnlyRootFileSystem: true
      podMonitor:
        enabled: true
