---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: reloader
spec:
  chartRef:
    kind: OCIRepository
    name: reloader
  interval: 1h
  values:
    fullnameOverride: reloader
    reloader:
      readOnlyRootFileSystem: true
      # Restart workloads through a pod template annotation instead of a dummy
      # env var in their containers, as upstream recommends for GitOps.
      reloadStrategy: annotations
      podMonitor:
        enabled: true
