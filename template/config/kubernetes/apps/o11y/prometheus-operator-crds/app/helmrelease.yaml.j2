---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: prometheus-operator-crds
spec:
  chart:
    kind: OCIRepository
    spec:
      interval: 15m
      url: oci://ghcr.io/prometheus-community/charts/prometheus-operator-crds
      ref:
        tag: 33.0.2
  interval: 1h
  values:
    crds:
      # The chart renders its CRDs as templates, so without this an uninstall
      # deletes them along with every ServiceMonitor and PodMonitor.
      annotations:
        helm.sh/resource-policy: keep
