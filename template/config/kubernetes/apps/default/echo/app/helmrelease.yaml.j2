---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: echo
spec:
  chart:
    kind: OCIRepository
    spec:
      interval: 15m
      url: oci://ghcr.io/home-operations/charts/echo
      ref:
        tag: 0.2.7
  interval: 1h
  values:
    replicaCount: #{ 2 if nodes | length > 1 else 1 }#
    config:
      commandsEnabled: false
      trustedProxies:
        - "#{ kubernetes.pod_cidr }#"
    httpRoute:
      enabled: true
      hostnames:
        - "{{ .Release.Name }}.${SECRET_DOMAIN}"
      parentRefs:
        - name: envoy-#{ 'external' if ingress.mode != 'none' else 'internal' }#
          namespace: network
    monitoring:
      serviceMonitor:
        enabled: true
    resources:
      requests:
        cpu: 10m
      limits:
        memory: 64Mi
