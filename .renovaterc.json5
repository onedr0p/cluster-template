{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-presets#12.0.0"],
  schedule: ["every weekend"],
  mise: {
    managerFilePatterns: ["/^\\.mise/conf\\.d/[^/]+\\.toml$/"],
  },
  customManagers: [
    {
      // Renovate's flux manager only reads `chartRef` or HelmChart templates,
      // not an inline `chart.kind: OCIRepository` template (Flux 2.10+)
      customType: "regex",
      description: "Process Flux HelmRelease inline OCIRepository charts",
      managerFilePatterns: ["/(^|/)helmrelease\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: [
        "\\n\\s+url: oci://(?<depName>\\S+)\\n\\s+ref:\\n\\s+tag: (?<currentValue>\\S+)",
      ],
      datasourceTemplate: "docker",
      depTypeTemplate: "HelmChart",
      // The flux manager resolved mirror.gcr.io via registryAliases, which custom managers ignore
      packageNameTemplate: "{{{replace '^mirror\\.gcr\\.io/' 'docker.io/' depName}}}",
    },
  ],
  packageRules: [
    {
      description: "GitHub Actions Group",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Soft Serve runs as the Git server in the cluster E2E",
      matchPackageNames: ["ghcr.io/charmbracelet/soft-serve"],
      minimumReleaseAge: "3 days",
    },
    {
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
      minimumReleaseAge: "3 days",
      overrideDatasource: "github-releases",
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Cloudflared Group",
      groupName: "cloudflared",
      matchPackageNames: ["cloudflare/cloudflared", "docker.io/cloudflare/cloudflared"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
}
